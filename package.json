{
  "name": "digit",
  "version": "0.1.0-rc.2",
  "description": "Declarative Minecraft servers, ready in minutes",
  "type": "module",
  "private": true,
  "bin": {
    "digit": "src/cli.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "test": "bun test",
    "check": "bun --bun tsc --noEmit",
    "build": "bun build --compile src/cli.ts --outfile dist/digit",
    "build:all": "bun scripts/build.ts",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "docs:check": "bun scripts/check-docs.ts"
  },
  "dependencies": {
    "@bomb.sh/tab": "0.0.22",
    "@clack/prompts": "1.8.1",
    "commander": "15.0.0",
    "smol-toml": "1.9.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "homepage": "https://ziffer.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZifferDev/digit.git"
  }
}
